{
  "name": "carrito-comidas-backend",
  "version": "1.0.0",
  "description": "Backend para sistema de pedidos de carrito de comidas",
  "main": "src/index.js",
  "scripts": {
    "prestart": "knex migrate:latest --env development",
    "start": "node src/index.js",
    "predev": "knex migrate:latest --env development",
    "dev": "nodemon src/index.js",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "migrate:make": "knex migrate:make",
    "db:setup": "knex migrate:latest",
    "db:status": "knex migrate:status"
  },
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.7.5",
    "mysql2": "^3.6.5",
    "knex": "^2.5.1",
    "uuid": "^9.0.1",
    "joi": "^17.11.0",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "express-rate-limit": "^7.1.5",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
